{
  "schema": "prometheus_source_adapter_v1",
  "policy_id": "flow_matching",
  "capabilities": {
    "distributed": "single_host",
    "hardware_rollout_authorized": false,
    "resume": "full_state_non_bit_exact"
  },
  "dataset": {
    "format": "prometheus_flow_matching_zarr_v1",
    "legacy_default": "arx_bimanual_v1",
    "embodiment_schemas": {
      "arx_bimanual_v1": {
        "action_contracts": {
          "abs_eef_rot6d": 20,
          "abs_qpos": 14,
          "relative_eef_rot6d": 20,
          "relative_qpos": 14
        },
        "native_array_dim": null
      },
      "cobot_magic_v1": {
        "action_contracts": {
          "abs_qpos": 14,
          "relative_qpos": 14
        },
        "native_array_dim": 14
      },
      "franka_wuji_v1": {
        "action_contracts": {
          "abs_qpos": 54
        },
        "native_array_dim": 54
      }
    },
    "camera_order": [
      "base_0",
      "left_wrist_0",
      "right_wrist_0"
    ]
  },
  "stages": {
    "doctor": true,
    "eval": true,
    "export": false,
    "prepare": true,
    "resume": true,
    "serve": false,
    "train": true
  }
}
